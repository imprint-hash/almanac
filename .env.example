# Bitget public market data needs no key.
# Qwen writes the answer in the question box; without a key the desk uses its own wording.
QWEN_API_KEY=
# qwen-max by default. Any OpenAI-compatible chat model id works.
QWEN_MODEL=qwen3.8-max
# Bitget's hackathon Qwen endpoint, OpenAI-compatible.
QWEN_ENDPOINT=https://hackathon.bitgetops.com/v1/chat/completions
# Optional: pin api.bitget.com to an IP when local DNS is flaky. Unset in production.
BITGET_IP=
# How many names the rail carries. Used by bin/refresh-normal.mjs.
ALMANAC_NAMES=40
